# Banco local
DATABASE_URL="mysql://approve:approve@localhost:3308/approve"

# API Nest
API_PORT=4334
WEB_ORIGIN="http://localhost:5005"
API_ADMIN_KEY="terc-andar-n3"

# Web Next
WEB_PORT=5005
API_URL="http://localhost:4334"
APP_URL="http://localhost:5005"

# Usuário DEV local.
# Para manter compatibilidade, o seed também aceita DESIGNER_NAME/EMAIL/PASSWORD.
DEV_NAME="Dev Terceiro Andar"
DEV_EMAIL="designer@dev.com"
DEV_PASSWORD="senha123"

# Usuário ADMIN local.
ADMIN_NAME="Admin Terceiro Andar"
ADMIN_EMAIL="admin@dev.com"
ADMIN_PASSWORD="senha123"

# Designer de demonstração responsável pelo Cliente Demo.
STAFF_DESIGNER_NAME="Designer Demo"
STAFF_DESIGNER_EMAIL="social@dev.com"
STAFF_DESIGNER_PASSWORD="senha123"

# Nextcloud / artes
# A conta técnica precisa ter acesso à pasta raiz configurada abaixo.
# Cada cliente usa, por padrão: NEXTCLOUD_ROOT_PATH/<slug-do-cliente>
NEXTCLOUD_URL="https://fileserver.terceiroandar.com.br"
NEXTCLOUD_USERNAME="approve-integration"
NEXTCLOUD_APP_PASSWORD="cole-a-app-password-aqui"
NEXTCLOUD_ROOT_PATH="/Clientes"


# SMTP / recuperação de senha
# Exemplo para porta 587: SMTP_SECURE=false e SMTP_STARTTLS=true.
# Para porta 465: SMTP_SECURE=true.
SMTP_HOST="smtp.seudominio.com.br"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER="aprovacao@terceiroandar.com.br"
SMTP_PASSWORD="senha-ou-app-password"
SMTP_FROM="Terceiro Andar Aprovação <aprovacao@terceiroandar.com.br>"
SMTP_HELO="aprovacao.terceiroandar.com.br"
