generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEV
  ADMIN
  DESIGNER
}

enum Channel {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  STORIES
  OTHER
}

enum ContentType {
  POST
  CAROUSEL
  REEL
  STORY
}

enum ContentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CHANGES_REQUESTED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
}

enum AssetProvider {
  NEXTCLOUD
}

model Designer {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  role         UserRole          @default(DESIGNER)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     DesignerSession[]
  clients      Client[]          @relation("ClientDesigner")
}

model DesignerSession {
  id         String   @id @default(cuid())
  designerId String
  tokenHash  String   @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  designer   Designer @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId])
  @@index([expiresAt])
}

model Client {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  niche              String?
  phone              String?
  assignedDesignerId String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  assignedDesigner   Designer?         @relation("ClientDesigner", fields: [assignedDesignerId], references: [id], onDelete: SetNull)
  credential         ClientCredential?
  sessions           ClientSession[]
  calendars          Calendar[]

  @@index([assignedDesignerId])
}

model ClientCredential {
  id           String   @id @default(cuid())
  clientId     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientSession {
  id        String   @id @default(cuid())
  clientId  String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([expiresAt])
}

model ContentFormat {
  id              String        @id @default(cuid())
  name            String
  contentType     ContentType
  width           Int
  height          Int
  supportsFeed    Boolean       @default(true)
  supportsStories Boolean       @default(false)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contentItems    ContentItem[]

  @@index([contentType, active])
}

model Calendar {
  id           String               @id @default(cuid())
  clientId     String
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  shareToken   String               @unique @db.VarChar(64)
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  postingDays  CalendarPostingDay[]

  @@index([clientId])
  @@index([periodStart, periodEnd])
}

model CalendarPostingDay {
  id            String   @id @default(cuid())
  calendarId    String
  scheduledDate DateTime
  createdAt     DateTime @default(now())
  calendar      Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, scheduledDate])
  @@index([scheduledDate])
}

model ContentItem {
  id               String        @id @default(cuid())
  calendarId       String
  formatId         String?
  title            String
  scheduledAt      DateTime
  channel          Channel       @default(INSTAGRAM)
  contentType      ContentType   @default(POST)
  format           String
  publishToFeed    Boolean       @default(true)
  publishToStories Boolean       @default(false)
  caption          String        @db.Text
  assetUrl         String?       @db.Text
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  calendar         Calendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  formatPreset     ContentFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)
  assets           ContentAsset[]
  reviews          ReviewHistory[]

  @@index([calendarId, scheduledAt])
  @@index([formatId])
  @@index([status])
}

model ContentAsset {
  id            String        @id @default(cuid())
  contentItemId String
  provider      AssetProvider @default(NEXTCLOUD)
  filePath      String        @db.Text
  fileName      String
  fileId        String?
  mimeType      String?
  etag          String?
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  contentItem   ContentItem   @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, sortOrder])
}

model ReviewHistory {
  id            String       @id @default(cuid())
  contentItemId String
  action        ReviewAction
  message       String?      @db.Text
  reviewerName  String?
  createdAt     DateTime     @default(now())
  contentItem   ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId, createdAt])
}
